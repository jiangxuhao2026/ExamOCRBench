{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["batch_id", "record_id", "image", "queries"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["query_id", "query", "target_type"],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "target_type": {"enum": ["HandwrittenAnswer", "Question", "Instruction", "StudentCorrection"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
