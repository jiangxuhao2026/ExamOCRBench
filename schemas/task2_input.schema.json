{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamOCRBench Public Task2 Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "image", "coordinate_system", "target_element_types"],
  "properties": {
    "schema_version": {"const": "examocrbench_task2_public_input_v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "image_width": {"type": "integer", "minimum": 1},
    "image_height": {"type": "integer", "minimum": 1},
    "coordinate_system": {"const": "normalized_1000"},
    "target_element_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
