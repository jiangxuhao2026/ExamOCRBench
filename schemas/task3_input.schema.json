{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamOCRBench Public Task3 Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "query_id", "image", "coordinate_system", "target_type", "query"],
  "properties": {
    "schema_version": {"const": "examocrbench_task3_public_input_v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "coordinate_system": {"const": "normalized_1000"},
    "target_type": {"enum": ["HandwrittenAnswer", "Question", "Instruction", "StudentCorrection"]},
    "query": {"type": "string", "minLength": 4}
  }
}
