{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamOCRBench Public Task1 Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "image", "subject", "questions"],
  "properties": {
    "schema_version": {"const": "examocrbench_task1_public_input_v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "student_answers_visible": {"type": "boolean"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_key", "answer_units"],
        "properties": {
          "question_key": {"type": "string", "minLength": 1},
          "question_text": {"type": "string"},
          "response_form": {"type": "string"},
          "section_context": {"type": "array", "items": {"type": "string"}},
          "section_title": {"type": "string"},
          "visible_locator": {"type": "string"},
          "answer_units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["unit_key", "answer_type", "max_points"],
              "properties": {
                "unit_key": {"type": "string", "minLength": 1},
                "answer_type": {"type": "string"},
                "max_points": {"type": "number", "minimum": 0},
                "matching_pair_index": {"type": "integer", "minimum": 1},
                "matching_pair_total": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
